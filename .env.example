# GuiGazer Environment Variables
# ================================
# Copy this file to .env and fill in your keys.

# NVIDIA NIM API (Primary VLM)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_VLM_MODEL=meta/llama-3.2-90b-vision-instruct

# OpenAI (Fallback VLM)
OPENAI_API_KEY=

# Detector
DETECTOR_CONFIDENCE=0.35
DETECTOR_IOU_THRESHOLD=0.45

# Agent
MAX_AGENT_STEPS=15

# Server
HOST=0.0.0.0
PORT=8001
